{
  "manifest_version": 3,
  "name": "碧蓝幻想缓存控制台",
  "version": "2.1.0",
  "description": "碧蓝幻想本地缓存的浏览器伴侣：点击图标在侧边栏看实时控制台；程序可随浏览器启动/退出。v2.1.0 起扩展不再修改浏览器代理，代理仅由启动模式或用户手动设置接入，固定 key 与扩展 ID 保持不变。",
  "minimum_chrome_version": "114",
  "key": "",
  "permissions": [
    "sidePanel",
    "proxy",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://127.0.0.1:8799/*"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "action": {
    "default_title": "碧蓝幻想缓存控制台（点击打开侧栏；扩展不接管代理）",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
