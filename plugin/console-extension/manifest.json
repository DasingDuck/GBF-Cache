{
  "manifest_version": 3,
  "name": "碧蓝幻想缓存控制台",
  "version": "1.1.1",
  "description": "独立侧边栏控制台：点击图标在浏览器侧栏查看碧蓝幻想本地缓存程序的实时状态。与负责代理/PAC 的扩展互不依赖。",
  "minimum_chrome_version": "114",
  "permissions": [
    "sidePanel"
  ],
  "host_permissions": [
    "http://127.0.0.1:8799/*"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "action": {
    "default_title": "打开缓存控制台",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
