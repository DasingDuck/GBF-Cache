{
  "manifest_version": 3,
  "name": "碧蓝幻想本地缓存程序",
  "version": "2.2.1",
  "description": "让碧蓝幻想资源从本机缓存读取。v2.2.1：拉取服务端 PAC 时剔除注释并保证纯 ASCII（Chromium 的 pacScript.data 拒绝非 ASCII，旧版因此静默失败只剩兜底）；v2.2.0：可随浏览器启动/退出本地缓存程序（原生消息宿主，需先运行 register-native-host.ps1 注册）。",
  "minimum_chrome_version": "114",
  "key": "",
  "permissions": [
    "proxy",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://127.0.0.1:8799/*"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "action": {
    "default_title": "碧蓝幻想本地缓存程序"
  }
}
